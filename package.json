{
  "name": "apex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "npx ts-node --project tsconfig.scripts.json scripts/db-init.ts",
    "calendar:auth": "npx ts-node --project tsconfig.scripts.json scripts/calendar-auth.ts",
    "worker": "npx ts-node --project tsconfig.scripts.json scripts/alert-worker.ts",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "BUILD_STANDALONE=1 next build && electron-builder --mac",
    "electron:build:dir": "BUILD_STANDALONE=1 next build && electron-builder --mac --dir"
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "tailwindcss": "^3.4.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "zustand": "^4.5.2",
    "better-sqlite3": "^9.4.3",
    "recharts": "^2.12.7",
    "chokidar": "^3.6.0",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "react-markdown": "^9.0.1",
    "googleapis": "^140.0.1",
    "@solana/web3.js": "^1.95.3",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "cmdk": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "tailwind-merge": "^2.3.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "swr": "^2.2.5",
    "@anthropic-ai/sdk": "0.27.3",
    "electron-is-dev": "^3.0.0",
    "wait-on": "^7.2.0",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "ts-node": "^10.9.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@types/wait-on": "^5.3.4"
  },
  "main": "electron/main.js"
}
